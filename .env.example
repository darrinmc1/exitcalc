# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (entitlements + downloads) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (TTPN test mode — leave both flags false until Preview is checked) ──
# Server gate. /api/checkout (POST) and /api/stripe/webhook return 503 unless this is the string true.
STRIPE_ENABLED=false
# Baked into the client at build time. Buy buttons stay "Coming soon" unless this is the string true.
# A product with available: false (the workbook, until its file exists) stays "Coming soon" even when this is true.
NEXT_PUBLIC_STRIPE_ENABLED=false
# TTPN test secret (sk_test_…). Never commit the value.
STRIPE_SECRET_KEY=
# Signing secret for this site's test webhook endpoint. Never commit the value.
STRIPE_WEBHOOK_SECRET=
# Lookup-key prefix. Code builds exitcalc_workbook_once_aud59 and exitcalc_pro_m_aud9.
# Checkout sessions use currency aud. Prices display as AU$59 and AU$9/mo.
STRIPE_SITE_KEY=exitcalc
# Prebuilt Checkout does not need a publishable key. Leave blank unless a client SDK is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Mailchimp (direct-submit popup — action URL goes in waitlist-popup.tsx) ───
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SITE_TAG=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
# Verified Resend sender on a domain you control. Do not use an @example.com placeholder.
RESEND_FROM=
RESEND_REPLY_TO=
NOTIFY_EMAIL=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=
SITE_KEY=
# Public contact address for the footer, buy line, and refund copy.
# Falls back to config/site.config.ts contact.email when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Canonical domain for sitemap + OG tags (no protocol). Falls back to Vercel URL, then site.config domain.
NEXT_PUBLIC_SITE_DOMAIN=
# Show GitHub link in footer (set "true" to show; unset/false hides it)
NEXT_PUBLIC_SHOW_GITHUB_FOOTER=
